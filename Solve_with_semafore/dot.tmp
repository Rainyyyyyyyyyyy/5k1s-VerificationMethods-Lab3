digraph p_phil {
size="8,10";
  GT [shape=box,style=dotted,label="phil"];
  GT -> S1;
	S1 -> S25  [color=black,style=solid,label="printf('MSC: phil # %d  ',mn)"];
	S25 -> S3  [color=black,style=solid,label="((cur_state==1))"];
	S25 -> S7  [color=black,style=solid,label="((cur_state==2))"];
	S25 -> S10  [color=black,style=solid,label="((cur_state==3))"];
	S25 -> S13  [color=black,style=solid,label="((cur_state==4))"];
	S25 -> S15  [color=black,style=solid,label="((cur_state==5))"];
	S25 -> S18  [color=black,style=solid,label="((cur_state==6))"];
	S25 -> S21  [color=black,style=solid,label="((cur_state==7))"];
	S25 -> S24  [color=black,style=solid,label="((cur_state==0))"];
	S3 -> S4  [color=black,style=bold,label="waiter!REQUEST"];
	S4 -> S5  [color=black,style=bold,label="waiter?GRANT"];
	S5 -> S25  [color=black,style=solid,label="cur_state = 2"];
	S7 -> S8  [color=black,style=bold,label="left!msgtype"];
	S8 -> S25  [color=black,style=solid,label="cur_state = 3"];
	S10 -> S11  [color=black,style=bold,label="right!msgtype"];
	S11 -> S25  [color=black,style=solid,label="cur_state = 4"];
	S13 -> S25  [color=black,style=solid,label="cur_state = 5"];
	S15 -> S16  [color=black,style=bold,label="right!msgtype"];
	S16 -> S25  [color=black,style=solid,label="cur_state = 6"];
	S18 -> S19  [color=black,style=bold,label="left!msgtype"];
	S19 -> S25  [color=black,style=solid,label="cur_state = 7"];
	S21 -> S22  [color=black,style=bold,label="waiter!DONE"];
	S22 -> S25  [color=black,style=solid,label="cur_state = 0"];
	S24 -> S25  [color=black,style=solid,label="cur_state = 1"];
}
digraph p_fork {
size="8,10";
  GT [shape=box,style=dotted,label="fork"];
  GT -> S15;
	S15 -> S7  [color=black,style=solid,label="((cur_state_fork==0))"];
  S15 [color=blue,style=bold,shape=box];
	S15 -> S10  [color=black,style=solid,label="((cur_state_fork==1))"];
  S15 [color=blue,style=bold,shape=box];
	S15 -> S13  [color=black,style=solid,label="((cur_state_fork==2))"];
  S15 [color=blue,style=bold,shape=box];
	S7 -> S3  [color=black,style=bold,label="right_phil?msgtype"];
	S7 -> S5  [color=black,style=bold,label="left_phil?msgtype"];
	S7 -> S15  [color=black,style=bold,label="(1)"];
	S3 -> S15  [color=black,style=solid,label="cur_state_fork = 2"];
	S5 -> S15  [color=black,style=solid,label="cur_state_fork = 1"];
	S10 -> S11  [color=black,style=bold,label="left_phil?msgtype"];
	S11 -> S15  [color=black,style=solid,label="cur_state_fork = 0"];
	S13 -> S14  [color=black,style=bold,label="right_phil?msgtype"];
	S14 -> S15  [color=black,style=solid,label="cur_state_fork = 0"];
}
digraph p_waiter {
size="8,10";
  GT [shape=box,style=dotted,label="waiter"];
  GT -> S32;
	S32 -> S17  [color=black,style=solid,label="((count<(5-1)))"];
	S32 -> S30  [color=black,style=solid,label="((count>0))"];
	S17 -> S3  [color=black,style=bold,label="w[0]?REQUEST"];
	S17 -> S6  [color=black,style=bold,label="w[1]?REQUEST"];
	S17 -> S9  [color=black,style=bold,label="w[2]?REQUEST"];
	S17 -> S12  [color=black,style=bold,label="w[3]?REQUEST"];
	S17 -> S15  [color=black,style=bold,label="w[4]?REQUEST"];
	S3 -> S4  [color=black,style=bold,label="w[0]!GRANT"];
	S4 -> S32  [color=black,style=solid,label="count = (count+1)"];
	S6 -> S7  [color=black,style=bold,label="w[1]!GRANT"];
	S7 -> S32  [color=black,style=solid,label="count = (count+1)"];
	S9 -> S10  [color=black,style=bold,label="w[2]!GRANT"];
	S10 -> S32  [color=black,style=solid,label="count = (count+1)"];
	S12 -> S13  [color=black,style=bold,label="w[3]!GRANT"];
	S13 -> S32  [color=black,style=solid,label="count = (count+1)"];
	S15 -> S16  [color=black,style=bold,label="w[4]!GRANT"];
	S16 -> S32  [color=black,style=solid,label="count = (count+1)"];
	S30 -> S21  [color=black,style=bold,label="w[0]?DONE"];
	S30 -> S23  [color=black,style=bold,label="w[1]?DONE"];
	S30 -> S25  [color=black,style=bold,label="w[2]?DONE"];
	S30 -> S27  [color=black,style=bold,label="w[3]?DONE"];
	S30 -> S29  [color=black,style=bold,label="w[4]?DONE"];
	S21 -> S32  [color=black,style=solid,label="count = (count-1)"];
	S23 -> S32  [color=black,style=solid,label="count = (count-1)"];
	S25 -> S32  [color=black,style=solid,label="count = (count-1)"];
	S27 -> S32  [color=black,style=solid,label="count = (count-1)"];
	S29 -> S32  [color=black,style=solid,label="count = (count-1)"];
}
digraph init {
size="8,10";
  GT [shape=box,style=dotted,label="init"];
  GT -> S1;
	S1 -> S2  [color=black,style=solid,label="(run phil(d[0],c[0],w[0],0))"];
	S2 -> S3  [color=black,style=solid,label="(run phil(d[1],c[1],w[1],1))"];
	S3 -> S4  [color=black,style=solid,label="(run phil(d[2],c[2],w[2],2))"];
	S4 -> S5  [color=black,style=solid,label="(run phil(d[3],c[3],w[3],3))"];
	S5 -> S6  [color=black,style=solid,label="(run phil(d[4],c[4],w[4],4))"];
	S6 -> S7  [color=black,style=solid,label="(run fork(c[0],d[1]))"];
	S7 -> S8  [color=black,style=solid,label="(run fork(c[1],d[2]))"];
	S8 -> S9  [color=black,style=solid,label="(run fork(c[2],d[3]))"];
	S9 -> S10  [color=black,style=solid,label="(run fork(c[3],d[4]))"];
	S10 -> S11  [color=black,style=solid,label="(run fork(c[4],d[0]))"];
	S11 -> S12  [color=black,style=solid,label="(run waiter())"];
	S12 -> S0  [color=black,style=solid,label="-end-"];
  S12 [color=blue,style=bold,shape=box];
}
